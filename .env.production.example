MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT
MYSQL_DATABASE=knowledge_os
MYSQL_USER=knowledge
MYSQL_PASSWORD=CHANGE_ME_DB
DB_USERNAME=knowledge
DB_PASSWORD=CHANGE_ME_DB
NEO4J_PASSWORD=CHANGE_ME_NEO4J
AI_SERVICE_BASE_URL=http://ai-service:12000
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
GRAPH_PROVIDER=neo4j
RERANKER_ENABLED=false
INSTALL_ML=false
STARTUP_FAIL_FAST=true
PUBLIC_HTTP_PORT=8088

# ---------- Retrieval Engines ----------
RETRIEVAL_MODE=auto
RETRIEVAL_EXTERNAL_REQUIRED=false
RETRIEVAL_TIMEOUT_SECONDS=5
RETRIEVAL_BATCH_SIZE=200
ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX=llmkb_knowledge_v1
ELASTICSEARCH_USERNAME=admin
ELASTICSEARCH_PASSWORD=${ELASTICSEARCH_INITIAL_ADMIN_PASSWORD}
ELASTICSEARCH_VERIFY_SSL=false
MILVUS_ENABLED=true
MILVUS_URL=http://milvus:19530
MILVUS_COLLECTION=llmkb_knowledge_v1
MILVUS_TOKEN=

ELASTICSEARCH_INITIAL_ADMIN_PASSWORD=ChangeThis_StrongPassword_2026!

# Transactional Outbox / Index Worker
INDEX_OUTBOX_ENABLED=true
INDEX_OUTBOX_POLL_INTERVAL_MS=1000
INDEX_OUTBOX_BATCH_SIZE=20
INDEX_OUTBOX_MAX_ATTEMPTS=8
INDEX_OUTBOX_RETRY_BASE_SECONDS=2
INDEX_OUTBOX_LOCK_TIMEOUT_SECONDS=300

# Index operations / observability
INDEX_OUTBOX_ARCHIVE_ENABLED=true
INDEX_OUTBOX_RETENTION_DAYS=14
INDEX_OUTBOX_ARCHIVE_BATCH_SIZE=500
INDEX_OUTBOX_ARCHIVE_INTERVAL_MS=3600000
ELASTICSEARCH_READ_ALIAS=llmkb_knowledge_read
MILVUS_READ_ALIAS=llmkb_knowledge_read

# Index operations RBAC
OPS_RBAC_ENABLED=true
OPS_VIEWER_TOKEN=CHANGE_ME_32_CHAR_RANDOM_VIEWER_TOKEN
OPS_OPERATOR_TOKEN=CHANGE_ME_32_CHAR_RANDOM_OPERATOR_TOKEN
OPS_ADMIN_TOKEN=CHANGE_ME_32_CHAR_RANDOM_ADMIN_TOKEN

ELASTICSEARCH_ANALYZER=standard
