# =============================================================================
# AI Knowledge OS 部署配置
#
# install.sh 会把它复制为 .env。带 CHANGE_ME 的项上线前必须修改，
# 改完执行 ./stop.sh && ./start.sh 生效（改端口需要重新 up 才会重建端口映射）。
#
# 说明：本文件同时用于两处——
#   1. compose 的变量替换（VERSION / IMAGE_PREFIX / 端口 / 各中间件账号密码）
#   2. 作为 env_file 注入容器（模型服务地址、ES 账号等）
# =============================================================================

# ---- 版本与镜像 ----
VERSION=1.1.0
# 私有镜像仓库前缀。离线安装包（images/ 下有镜像包）保持默认；从仓库拉取时改成
# 例如 registry.example.com/knowledge-os
IMAGE_PREFIX=knowledge-os

# ---- 对外端口 ----
PUBLIC_HTTP_PORT=8088
BACKEND_HTTP_PORT=8080
PROMETHEUS_HTTP_PORT=9090
GRAFANA_HTTP_PORT=3000

# ---- MySQL ----
MYSQL_DATABASE=knowledge_os
MYSQL_USER=knowledge
MYSQL_PASSWORD=CHANGE_ME

# ---- Redis ----
# 留空表示不启用密码，仅限内网可信环境。设置后 redis 以 --requirepass 启动。
REDIS_PASSWORD=CHANGE_ME

# ---- Elasticsearch ----
# 必填。ES 内置 elastic 用户的初始密码，仅在首次启动（卷为空）时生效，之后改这里无效。
ELASTICSEARCH_INITIAL_ADMIN_PASSWORD=CHANGE_ME
ELASTICSEARCH_USERNAME=elastic
# 业务服务连接 ES 用的密码，需与上面一致。
ELASTICSEARCH_PASSWORD=CHANGE_ME
# 容器内地址；ES 开启了 TLS 认证，故用 https
ELASTICSEARCH_URL=http://elasticsearch:9200
# 堆内存：建议设为主机可用内存的四分之一，且不超过 31g
ES_JAVA_OPTS=-Xms2g -Xmx2g

# ---- Milvus ----
MILVUS_URL=http://milvus:19530

# ---- Neo4j ----
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME
NEO4J_HTTP_URL=http://neo4j:7474
NEO4J_HEAP_INIT=1G
NEO4J_HEAP_MAX=4G
NEO4J_PAGECACHE=1G

# ---- 模型服务（ai-service）----
# 默认对接 Ollama。生产请指向实际部署的模型服务。
LLM_PROVIDER=ollama
# 容器内的 ai-service 访问宿主机 Ollama 时，用 http://host.docker.internal:11434
# （Linux 上需在 compose 里加 extra_hosts: "host.docker.internal:host-gateway"）
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
# 必须与所选嵌入模型的实际维度一致，改模型不改这里会导致写入向量库失败
EMBEDDING_DIM=768
EMBEDDING_API_KEY=

# ---- 嵌入组件（可选）----
# 多副本 backend 必须共用同一个密钥，否则一个副本签发的令牌在另一个副本校验失败。
EXTERNAL_EMBED_TOKEN_SECRET=CHANGE_ME
# 允许嵌入组件的站点来源，逗号分隔；留空表示不限制。
EXTERNAL_ALLOWED_ORIGINS=

# ---- 演示数据 ----
# auto = 业务表为空时灌入镜像内置快照，部署后可直接演示；false = 保持空系统。
DEMO_SEED=auto

# ---- Grafana ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
