# v1.1 开发环境变量模板
# 使用：cp .env.dev.example .env.dev （.env.dev 已纳入 .gitignore，不会入库）
# 本文件只放本地开发默认值，生产密钥请使用部署环境的密钥机制。

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=knowledge_os
MYSQL_USER=knowledge
MYSQL_PASSWORD=knowledge123
DB_URL=jdbc:mysql://mysql:3306/knowledge_os?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=knowledge
DB_PASSWORD=knowledge123
DB_POOL_MAX=10
DB_POOL_MIN=2

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
# 留空表示不启用鉴权；设置后 ai-service/backend/redis 会同步开启 requirepass
REDIS_PASSWORD=

# ---------- Neo4j ----------
GRAPH_PROVIDER=neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=knowledge123
NEO4J_DATABASE=neo4j

# ---------- 模型服务（外部 Ollama：http://192.168.22.6:11434）----------
# LLM 与 Embedding 共用同一个 Ollama 地址（OllamaEmbeddingProvider 读 LLM_BASE_URL）
LLM_PROVIDER=ollama
LLM_BASE_URL=http://192.168.22.6:11434
# 192.168.22.6 上已拉取的模型：qwen2.5:7b / llama3.2 / deepseek-R1 / deepseek-ocr
LLM_MODEL=qwen2.5:7b
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
# nomic-embed-text 输出 768 维；使用 hash 兜底 provider 时改回 384
EMBEDDING_DIM=768

# ---------- Reranker ----------
# 开启需先设置 INSTALL_ML=true 构建带 ML 依赖的镜像
INSTALL_ML=false
RERANKER_ENABLED=false
RERANKER_PROVIDER=bge
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=auto
RERANKER_BATCH_SIZE=4
RERANKER_CONCURRENCY=1

# ---------- Backend / AI 集成 ----------
AI_SERVICE_BASE_URL=http://ai-service:12000
AI_CONNECT_TIMEOUT_MS=10000
AI_READ_TIMEOUT_MS=180000
STARTUP_FAIL_FAST=false
KNOWLEDGE_DATA_DIR=/app/data
LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO

# ---------- 检索模式 ----------
# 开发环境默认不启动 ES/Milvus，auto 模式下自动降级为：
# 本地 BM25 + 本地向量 + Neo4j 图召回
RETRIEVAL_MODE=auto
RETRIEVAL_EXTERNAL_REQUIRED=false
RETRIEVAL_TIMEOUT_SECONDS=5
RETRIEVAL_BATCH_SIZE=200
ELASTICSEARCH_ENABLED=false
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX=llmkb_knowledge_v1
ELASTICSEARCH_READ_ALIAS=llmkb_knowledge_read
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_VERIFY_SSL=false
ELASTICSEARCH_ANALYZER=standard
MILVUS_ENABLED=false
MILVUS_URL=http://milvus:19530
MILVUS_COLLECTION=llmkb_knowledge_v1
MILVUS_READ_ALIAS=llmkb_knowledge_read
MILVUS_TOKEN=

# ---------- Transactional Outbox / Index Worker ----------
INDEX_OUTBOX_ENABLED=true
INDEX_OUTBOX_POLL_INTERVAL_MS=1000
INDEX_OUTBOX_BATCH_SIZE=20
INDEX_OUTBOX_MAX_ATTEMPTS=8
INDEX_OUTBOX_RETRY_BASE_SECONDS=2
INDEX_OUTBOX_LOCK_TIMEOUT_SECONDS=300
INDEX_OUTBOX_ARCHIVE_ENABLED=true
INDEX_OUTBOX_RETENTION_DAYS=14
INDEX_OUTBOX_ARCHIVE_BATCH_SIZE=500
INDEX_OUTBOX_ARCHIVE_INTERVAL_MS=3600000

# ---------- 运维接口 RBAC ----------
OPS_RBAC_ENABLED=false
OPS_VIEWER_TOKEN=change-me-viewer
OPS_OPERATOR_TOKEN=change-me-operator
OPS_ADMIN_TOKEN=change-me-admin

# ---------- 监控（profile: monitoring）----------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123

# ---------- 文件解析 ----------
CHUNK_SIZE=900
CHUNK_OVERLAP=120
RRF_K=60
CONTEXT_MAX_CHARS=8000
MAX_FILE_SIZE=100MB
MAX_REQUEST_SIZE=100MB
